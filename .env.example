# ---- COPY TO .env AND FILL. NEVER COMMIT .env ----
# Containers only (compose). Host-side development uses apps/api/.env with NODE_ENV=development.
NODE_ENV=production
APP_URL=http://localhost:8080
# Postgres (via PgBouncer for runtime, direct for migrations)
POSTGRES_USER=sirat
POSTGRES_PASSWORD=change-me-fake
POSTGRES_DB=sirat
DATABASE_URL=postgresql://sirat:change-me-fake@pgbouncer:6432/sirat?pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://sirat:change-me-fake@postgres:5432/sirat
# Redis (cache = lru, queue = noeviction)
REDIS_CACHE_URL=redis://redis-cache:6379
REDIS_QUEUE_URL=redis://redis-queue:6379
# Auth
# Required. Generate: openssl rand -base64 48 (the API refuses short, repetitive or placeholder values).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# Session cookies are host-only and Secure. `false` only for local plain-http testing; refused with NODE_ENV=production.
COOKIE_SECURE=true
# PayStation (sandbox first)
PAYSTATION_BASE_URL=https://sandbox.paystation.com.bd
PAYSTATION_MERCHANT_ID=fake
PAYSTATION_PASSWORD=fake
PAYSTATION_CALLBACK_URL=http://localhost:8080/api/payments/paystation/callback
# Email: only the worker sends. Owner: resend on the VPS (pre-launch checklist), mailpit locally (dev override).
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Sirat Olympiad <no-reply@sirat.test>
MAILPIT_URL=http://mailpit:8025
# With EMAIL_PROVIDER=resend: the Resend API key (re_...). Never logged or committed.
RESEND_API_KEY=
# Observability
SENTRY_DSN=
