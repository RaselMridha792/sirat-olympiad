# ---- COPY TO .env AND FILL. NEVER COMMIT .env ----
# Containers only (compose). Host-side development uses apps/api/.env with NODE_ENV=development.
NODE_ENV=production
# Public web origin: https://<host> in production (plain http only for localhost); nginx takes its TLS host name from it.
APP_URL=http://localhost:8080
# Postgres (via PgBouncer for runtime, direct for migrations)
POSTGRES_USER=sirat
POSTGRES_PASSWORD=change-me-fake
POSTGRES_DB=sirat
DATABASE_URL=postgresql://sirat:change-me-fake@pgbouncer:6432/sirat?pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://sirat:change-me-fake@postgres:5432/sirat
# Runtime role sirat_app (LAUNCH-PLAN L2): the migrate job gives it a login with this password (prisma/runtime-role.ts).
# Generate with `openssl rand -hex 32`. One value per Postgres cluster: on the shared dev stack, the same in every worktree
# (the first stack turn sets it, later ones keep it). Empty: the password step is skipped (the API uses it from L8).
POSTGRES_APP_PASSWORD=
# Redis (cache = lru, queue = noeviction)
REDIS_CACHE_URL=redis://redis-cache:6379
REDIS_QUEUE_URL=redis://redis-queue:6379
# Auth
# Required. Generate: openssl rand -base64 48 (the API refuses short, repetitive or placeholder values).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# A refresh rotation must commit within this many ms (100-10000), or it is rolled back and answers 503 while the
# old cookies keep working. Keep the default; DECISIONS "Refresh rotation inside a time budget".
REFRESH_ROTATION_BUDGET_MS=8000
# Requests per minute and route for one signed-in user, whatever IP they share (10-10000). Keep the default.
API_LIMIT_PER_USER_PER_MINUTE=120
# Session cookies are host-only and Secure. `false` only for local plain-http testing; refused with NODE_ENV=production.
COOKIE_SECURE=true
# Admin two-factor login (TOTP): the AES-256-GCM key for the stored secrets, 32 random bytes (base64 or 64 hex).
# REQUIRED for the api (compose pins NODE_ENV=production, which also turns 2FA enforcement on); the worker never
# needs it. Add it without printing it:  printf 'TOTP_ENCRYPTION_KEY=%s\n' "$(openssl rand -base64 32)" >> .env
# Keep a copy with the other secrets (the database backup does not hold it): without it no enrolled admin can sign
# in. Rotation: the old value goes to TOTP_ENCRYPTION_KEY_PREVIOUS (RUNBOOK section 21).
# TOTP_ENCRYPTION_KEY=
# TOTP_ENCRYPTION_KEY_PREVIOUS=
# Registration and payments: PayStation (docs/plans/PAYMENTS-PLAN.md section 3.5). PAYSTATION_ENV blank = payments
# disabled. Once set (sandbox | live), every rule applies at boot. `live` only with NODE_ENV=production. The host comes
# from an allow-list in the code; PAYSTATION_BASE_URL stays blank (it may only repeat that host). The merchant id is
# used exactly as issued, including any "-". Credentials are typed in on the server only: never in git, chat or logs.
PAYSTATION_ENV=
PAYSTATION_BASE_URL=
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
# Lowercase label of the account (copied into every payment), and the invoice prefix (1-3 of A-Z/0-9; not X or FX).
PAYSTATION_ACCOUNT_LABEL=
PAYSTATION_INVOICE_PREFIX=
# https://<domain>/api/payments/paystation/callback (the invoice is appended) and .../ipn (registered in the panel).
PAYSTATION_CALLBACK_URL=
PAYSTATION_IPN_URL=
# Only 0 is accepted: the merchant bears PayStation's charge (owner, 2026-10-31).
PAYSTATION_PAY_WITH_CHARGE=0
# Email: only the worker sends, and it refuses to start until a provider is configured. VPS: EMAIL_PROVIDER=ses, a
# sender on the SES-verified domain, and the keys of an IAM user allowed only ses:SendEmail (RUNBOOK section 9; never
# logged or committed). Locally the dev override always points the worker at Mailpit, whatever is set here.
EMAIL_PROVIDER=
EMAIL_FROM=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Operator inbox for security, payments and ops alerts (rate limited: one per kind per 10 min, and
# SECURITY_ALERT_EMAILS_PER_HOUR per category, default 6 each). Blank on a production server: a boot warning.
SECURITY_ALERT_EMAIL=
# Observability
SENTRY_DSN=
