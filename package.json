{
  "name": "sirat-olympiad",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @sirat/web dev",
    "dev:api": "pnpm --filter @sirat/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @sirat/api prisma:migrate",
    "db:generate": "pnpm --filter @sirat/api prisma:generate",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
