// Sirat Leadership Olympiad — database schema (PostgreSQL behind PgBouncer).
// Rules: migrations only; UUID (v7) PKs; timestamptz; real FKs/uniques; money = integer minor units.
// DB-level CHECKs that Prisma cannot express (e.g. duration_minutes <= 30) live in raw SQL migrations.
// Every FK has an index (Postgres does not create them automatically).
// Full explanation: docs/05-DATABASE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // via PgBouncer (?pgbouncer=true)
  directUrl = env("DIRECT_URL") // migrations go straight to Postgres
}

enum Role {
  student
  ambassador
  manager
  jury
  admin
}

enum Category {
  activist
  ambassador
  achiever
}

/// One registration attempt (docs/plans/PAYMENTS-PLAN.md section 5). completed, abandoned and conflict are final.
enum RegistrationAttemptStatus {
  open
  completed
  abandoned
  conflict
}

/// `refunded` is kept but never entered: there is no refund handling (DECISIONS 2026-10-31, owner); the
/// status-transition trigger refuses it.
enum PaymentStatus {
  initiated
  pending
  paid
  failed
  expired
  refunded
}

enum ExamStatus {
  draft
  published
  archived
}

enum AttemptStatus {
  in_progress
  submitted
  expired
  scored
}

enum AuthTokenType {
  email_verify
  password_reset
}

enum RoundType {
  quiz
  video
  final
}

enum EntryStatus {
  pending
  submitted
  evaluated
  promoted
  eliminated
}

enum TaskStatus {
  assigned
  submitted
  approved
  rejected
}

/// Why an exam ended (docs/plans/EXAM-PLAN.md 3.8, 3.9, 3.15).
enum EndReason {
  submitted // the student pressed Submit
  time_up // the player submitted at time-up
  violations // the player submitted after the 6th rule violation
  server_checkpoint // no submit by the end of the grace: the server used the last checkpoint
  server_empty // no submit and no checkpoint
}

// ───────────── Identity & sessions ─────────────

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.Citext // case-insensitive: A@x.com and a@x.com are the same account
  /// NULL for students and ambassadors: they log in with email + participant ID (owner, 2026-11-10). Staff always
  /// have one (CHECK users_password_for_staff).
  passwordHash    String?   @map("password_hash")
  name            String
  phone           String?   @unique // one number, one student; stored as 01XXXXXXXXX (CHECK in raw SQL); NULL for admins
  district        String?
  institution     String?
  educationType   String?   @map("education_type")
  gradeLevelId    String?   @map("grade_level_id") @db.Uuid
  category        Category?
  role            Role      @default(student) // never client-writable
  isBlocked       Boolean   @default(false) @map("is_blocked")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  signupSource    String?   @map("signup_source")
  referredById    String?   @map("referred_by_id") @db.Uuid // ambassador user who referred
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  gradeLevel             GradeLevel?             @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  referredBy             User?                   @relation("Referrals", fields: [referredById], references: [id], onDelete: Restrict)
  referrals              User[]                  @relation("Referrals")
  sessions               Session[]
  authTokens             AuthToken[]
  payments               Payment[]
  registration           Registration?
  attempts               Attempt[]
  ambassador             AmbassadorProfile?
  pointEntries           PointLedger[]           @relation("PointOwner")
  pointEntriesCreated    PointLedger[]           @relation("PointCreatedBy")
  teamsOwned             Team[]
  teamMember             TeamMember[]
  taskAssigns            TaskAssignment[]        @relation("TaskAssignee")
  taskApprovals          TaskAssignment[]        @relation("TaskApprover")
  tasksCreated           AdminTask[]
  roundEntries           RoundEntry[]
  juryScores             JuryScore[]
  certificates           Certificate[]
  announcements          Announcement[]
  registrationAttempt    PendingRegistration?    @relation("AttemptUser")
  referredAttempts       PendingRegistration[]   @relation("AttemptReferrer")
  bookOrder              BookOrder?              @relation("BookOrderOwner")
  bookOrdersShipped      BookOrder[]             @relation("BookOrderShipper")
  bookImages             BookImage[]             @relation("BookImageUploader")
  twoFactor              UserTwoFactor?
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  leaderboardEntries     LeaderboardEntry[]
  promotionRuns          PromotionRun[]
  juryAssignments        JuryAssignment[]        @relation("JuryAssignmentJudge")
  juryAssignmentsMade    JuryAssignment[]        @relation("JuryAssignmentCreatedBy")
  certificatesRevoked    Certificate[]           @relation("CertificateRevokedBy")
  keyCorrections         AnswerKeyCorrection[]
  /// Demo data only (DECISIONS 2026-11-08): written by the demo loader, never changed (a trigger), never set by the API.
  demoBatchId            String?                 @map("demo_batch_id") @db.Uuid
  demoBatch              DemoBatch?              @relation("DemoUsers", fields: [demoBatchId], references: [id], onDelete: Restrict)
  demoBatchesStarted     DemoBatch[]             @relation("DemoBatchCreator")

  @@index([referredById])
  @@index([gradeLevelId])
  @@index([role])
  @@index([createdAt])
  @@index([demoBatchId])
  @@map("users")
}

/// Refresh-token session. Rotation: each refresh creates a new row in the same family and revokes the old one.
/// Presenting a revoked token = reuse => revoke the whole family.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  /// The family proved a second factor (DECISIONS "Admin two-factor login"): set only when it starts after the code
  /// step or enable; a refresh copies it and never raises it.
  twoFactorVerified Boolean   @default(false) @map("two_factor_verified")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt]) // the nightly cleanup (LAUNCH-PLAN §9)
  @@index([revokedAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz
  usedAt    DateTime?     @map("used_at") @db.Timestamptz
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt]) // the nightly cleanup (LAUNCH-PLAN §9)
  @@map("auth_tokens")
}

/// Append-only (created_at only). actor_id is intentionally NOT a foreign key: the audit trail must
/// outlive the user row it refers to (see DECISIONS.md, 2026-10-30 A1).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. auth.login_failed, payment.manual_reconcile, role.change
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorId])
  @@index([action, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)]) // the admin audit viewer: newest first, keyset paging (core)
  @@index([actorId, createdAt(sort: Desc)]) // the viewer's actor filter (core)
  @@map("audit_logs")
}

// ───────────── Config (data-driven, admin editable) ─────────────

/// Grade level -> category mapping lives in DATA, not in substring matching on labels.
model GradeLevel {
  id        String   @id @default(uuid(7)) @db.Uuid
  label     String   @unique
  sortOrder Int      @unique @map("sort_order")
  category  Category
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  users     User[]

  @@map("grade_levels")
}

/// Key/value runtime settings: registration_open, registration_fee_minor, currency, leaderboard_public, ...
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

// ───────────── Payments & registration ─────────────

/// One PayStation checkout. N payments : 1 registration attempt ("try again" needs no new form). Raw SQL adds:
/// whole-taka and BDT-only CHECKs, paid => paid_amount_minor = amount_minor, the invoice format, one active payment
/// per attempt (partial unique index) and the status-transition trigger (a new row is always `initiated`).
model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  userId                String?       @map("user_id") @db.Uuid // null until the account exists (pay-then-register)
  pendingRegistrationId String        @map("pending_registration_id") @db.Uuid
  invoiceNumber         String        @unique @map("invoice_number")
  amountMinor           Int           @map("amount_minor") // fee snapshot in paisa; CHECKs in raw SQL
  currency              String // snapshot of settings.currency; always 'BDT' (CHECK)
  status                PaymentStatus @default(initiated)
  trxId                 String?       @unique @map("trx_id")
  payWithCharge         Boolean       @map("pay_with_charge") // snapshot; always false (merchant pays the charge)
  gatewayAccount        String        @map("gateway_account") // PAYSTATION_ACCOUNT_LABEL at start
  gatewayEnv            String        @map("gateway_env") // PAYSTATION_ENV at start, or 'demo' (CHECK); no default
  paidAmountMinor       Int?          @map("paid_amount_minor") // what PayStation reported, as a record
  paymentUrl            String?       @map("payment_url")
  gatewayStatus         String?       @map("gateway_status") // last raw trx_status, lowercased
  lastCheckedAt         DateTime?     @map("last_checked_at") @db.Timestamptz
  checkCount            Int           @default(0) @map("check_count")
  reviewReason          String?       @map("review_reason") // e.g. duplicate_payment, refund_reported
  expiresAt             DateTime      @map("expires_at") @db.Timestamptz
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  pendingRegistration PendingRegistration @relation(fields: [pendingRegistrationId], references: [id], onDelete: Restrict)
  registration        Registration?

  @@index([status, createdAt]) // reconciliation job scans pending by age
  @@index([userId])
  @@index([pendingRegistrationId])
  @@index([gatewayAccount, status])
  @@map("payments")
}

/// One registration attempt: the form stored SERVER-SIDE so it survives the PayStation round trip, another device
/// and a cleared browser. The account is created from it in the transaction that marks a payment paid.
/// Raw SQL adds: one open attempt per email and per phone (partial unique indexes), the phone format, and
/// completed <=> user_id and completed_at set.
model PendingRegistration {
  id              String                    @id @default(uuid(7)) @db.Uuid
  status          RegistrationAttemptStatus @default(open)
  email           String                    @db.Citext
  phone           String // normalised 01XXXXXXXXX
  name            String
  payload         Json? // rest of the form incl. the argon2id password hash; NULL once completed (retention)
  payloadVersion  Int                       @default(1) @map("payload_version")
  startRequestId  String                    @unique @map("start_request_id") @db.Uuid // double-click idempotency
  resumeTokenHash String                    @unique @map("resume_token_hash") // SHA-256 of the sirat_reg cookie
  referredById    String?                   @map("referred_by_id") @db.Uuid
  userId          String?                   @unique @map("user_id") @db.Uuid
  completedAt     DateTime?                 @map("completed_at") @db.Timestamptz
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  referredBy User?     @relation("AttemptReferrer", fields: [referredById], references: [id], onDelete: Restrict)
  user       User?     @relation("AttemptUser", fields: [userId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([email])
  @@index([phone])
  @@index([referredById])
  @@index([status, updatedAt])
  @@map("pending_registrations")
}

/// One paid payment <-> one registration. Replaying a callback can never create a second one.
/// Raw SQL adds a trigger: the payment must be `paid` and belong to the same user.
model Registration {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  paymentId String     @unique @map("payment_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User       @relation(fields: [userId], references: [id])
  payment   Payment    @relation(fields: [paymentId], references: [id])
  bookOrder BookOrder?

  @@unique([id, userId]) // for book_orders' composite foreign key: an order only for the student's own registration
  @@map("registrations")
}

/// Append-only log of everything PayStation told us and what we did with it (raw SQL: UPDATE, DELETE and TRUNCATE
/// refused). payment_id is intentionally NOT a foreign key, like audit_logs.actor_id: the log keeps unknown
/// invoices (payment_id NULL) and must never block or be blocked by payment rows.
model PaymentEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  paymentId     String?  @map("payment_id") @db.Uuid
  source        String // initiate | callback | ipn | status_v1 | admin (CHECK)
  invoiceNumber String?  @map("invoice_number")
  trxId         String?  @map("trx_id") // as received
  outcome       String // applied_paid, no_change, rejected_amount, refund_reported, ... (CHECK: snake_case)
  statusCode    String?  @map("status_code")
  trxStatus     String?  @map("trx_status")
  payload       Json? // redacted: no merchant credentials, payer phone masked; at most 16 KB (CHECK)
  actorId       String?  @map("actor_id") @db.Uuid // admin actions only; not a foreign key (as audit_logs)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([paymentId, createdAt])
  @@index([trxId])
  @@index([invoiceNumber])
  @@map("payment_events")
}

// ───────────── Exams ─────────────

model Exam {
  id                  String     @id @default(uuid(7)) @db.Uuid
  title               String
  category            Category?
  roundId             String?    @map("round_id") @db.Uuid
  windowStart         DateTime   @map("window_start") @db.Timestamptz
  windowEnd           DateTime   @map("window_end") @db.Timestamptz // CHECK (> window_start) in raw SQL
  durationMinutes     Int        @map("duration_minutes") // CHECK (1..30) in raw SQL
  questionsPerAttempt Int        @map("questions_per_attempt") // CHECK (> 0) in raw SQL
  graceSeconds        Int        @default(30) @map("grace_seconds") // CHECK (0..300) in raw SQL
  status              ExamStatus @default(draft)
  /// false (owner, Q2): everyone gets the same questions (active pool = questions_per_attempt); true: the admin
  /// chose a random draw from a larger pool.
  randomDraw          Boolean    @default(false) @map("random_draw")
  /// Raised by a trigger on every question write, so caches and attempts know which pool they used.
  contentVersion      Int        @default(1) @map("content_version")
  publishedAt         DateTime?  @map("published_at") @db.Timestamptz
  /// CHECK: never before window_end + grace (results stay hidden until the window closed for everyone).
  resultsPublishedAt  DateTime?  @map("results_published_at") @db.Timestamptz
  resultsSnapshotAt   DateTime?  @map("results_snapshot_at") @db.Timestamptz
  resultsGeneration   Int        @default(0) @map("results_generation")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  round              Round?                @relation(fields: [roundId], references: [id], onDelete: Restrict)
  questions          Question[]
  attempts           Attempt[]
  leaderboardEntries LeaderboardEntry[]
  promotionRuns      PromotionRun[]
  keyCorrections     AnswerKeyCorrection[]
  /// Demo data only: written by the demo loader, never changed, never set by the API (no DTO field).
  demoBatchId        String?               @map("demo_batch_id") @db.Uuid
  demoBatch          DemoBatch?            @relation(fields: [demoBatchId], references: [id], onDelete: Restrict)

  @@index([status, windowStart])
  @@index([roundId])
  @@index([demoBatchId])
  @@map("exams")
}

/// One row = one version of a question. Once its exam has left `draft`, the content never changes (trigger): an edit
/// inserts version + 1 in the same lineage and deactivates the old row; nothing is deleted. Attempts keep the exact
/// version ids they were given. One active version per lineage (partial unique index in raw SQL).
model Question {
  id              String                @id @default(uuid(7)) @db.Uuid
  examId          String                @map("exam_id") @db.Uuid
  lineageId       String                @map("lineage_id") @db.Uuid // groups the versions of one question
  text            String
  options         Json // [{ "key": "A", "text": "..." }, ...] (2-6, CHECK in raw SQL)
  correctKey      String                @map("correct_key") // server-only, never serialized to clients before results open
  explanation     String?
  version         Int                   @default(1)
  position        Int // admin order; versions keep it
  keepOptionOrder Boolean               @default(false) @map("keep_option_order") // e.g. "all of the above"
  isActive        Boolean               @default(true) @map("is_active")
  deactivatedAt   DateTime?             @map("deactivated_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  exam            Exam                  @relation(fields: [examId], references: [id])
  keyCorrections  AnswerKeyCorrection[]

  @@unique([lineageId, version])
  @@index([examId, isActive])
  @@map("questions")
}

model Attempt {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  examId           String        @map("exam_id") @db.Uuid
  startedAt        DateTime      @map("started_at") @db.Timestamptz
  endsAt           DateTime      @map("ends_at") @db.Timestamptz // = min(startedAt + duration, window_end)
  status           AttemptStatus @default(in_progress)
  /// Per-attempt drawn questions + shuffled order + shuffled options, decided on the server.
  /// v1: { "v": 1, "q": [questionId...], "o": [[2,0,3,1], ...] } (display order as indexes into each question's options)
  layout           Json
  questionCount    Int           @map("question_count") // N, fixed at start
  contentVersion   Int           @map("content_version") // the exam's content version the layout was drawn from
  submittedAt      DateTime?     @map("submitted_at") @db.Timestamptz
  timeTakenSeconds Int?          @map("time_taken_seconds") // computed by server, never client-reported
  score            Int?
  scoredAt         DateTime?     @map("scored_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user               User               @relation(fields: [userId], references: [id])
  exam               Exam               @relation(fields: [examId], references: [id])
  submission         Submission?
  leaderboardEntries LeaderboardEntry[]

  @@unique([userId, examId]) // one attempt per student per exam; timer can never be reset
  @@index([examId, status])
  @@index([examId, score(sort: Desc), timeTakenSeconds(sort: Asc)]) // leaderboard snapshot build
  @@map("attempts")
}

/// The single final submit. `requestId` makes the request idempotent. Checkpoints live in Redis only.
/// Append-only (created_at = when the server received it; trigger in raw SQL).
model Submission {
  id             String    @id @default(uuid(7)) @db.Uuid
  attemptId      String    @unique @map("attempt_id") @db.Uuid
  requestId      String    @unique @map("request_id") // client uuid, or auto.<attemptId> from the server finalize
  answers        Json // v1: { "v": 1, "a": [2, null, 0, ...] } option positions in the attempt's display order
  endReason      EndReason @map("end_reason")
  violationCount Int       @map("violation_count") // rule violations (EXAM-PLAN 3.15)
  events         Json? // violation and connection events with their times, for the admin
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  attempt        Attempt   @relation(fields: [attemptId], references: [id])

  @@map("submissions")
}

/// Results snapshot (EXAM-PLAN 3.12, D8): one row per scored attempt per build generation. Derived data, written once
/// by the build job; students read it only after the results are published.
model LeaderboardEntry {
  examId           String    @map("exam_id") @db.Uuid
  generation       Int
  position         Int // 1..n, a unique order
  rank             Int // shared on ties (1, 2, 2, 4)
  userId           String    @map("user_id") @db.Uuid
  attemptId        String    @map("attempt_id") @db.Uuid
  name             String
  institution      String?
  category         Category?
  score            Int
  timeTakenSeconds Int       @map("time_taken_seconds")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  exam             Exam      @relation(fields: [examId], references: [id], onDelete: Restrict)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt          Attempt   @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@id([examId, generation, position])
  @@index([examId, generation, rank])
  @@index([userId])
  @@index([attemptId])
  @@map("leaderboard_entries")
}

// ───────────── Rounds, jury, certificates ─────────────

model Round {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  sortOrder Int          @map("sort_order")
  type      RoundType
  opensAt   DateTime?    @map("opens_at") @db.Timestamptz
  closesAt  DateTime?    @map("closes_at") @db.Timestamptz
  /// Video rounds: the jury's criteria, [{ key, en, bn }], 0–10 each (core C6a); null for quiz and final rounds.
  /// Frozen once the round has a jury score.
  criteria  Json?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  exams     Exam[]
  entries   RoundEntry[]

  promotionsFrom  PromotionRun[]   @relation("PromotionFrom")
  promotionsTo    PromotionRun[]   @relation("PromotionTo")
  juryAssignments JuryAssignment[]
  certificates    Certificate[]
  /// Demo data's root marker (DECISIONS "Demo data"): written only by the demo loader, never changed.
  demoBatchId     String?          @map("demo_batch_id") @db.Uuid
  demoBatch       DemoBatch?       @relation(fields: [demoBatchId], references: [id], onDelete: Restrict)

  @@unique([sortOrder])
  @@index([demoBatchId])
  @@map("rounds")
}

/// One row per (user, round). Promotion creates the NEXT round's row with ON CONFLICT DO NOTHING — never overwrites.
model RoundEntry {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  roundId          String        @map("round_id") @db.Uuid
  status           EntryStatus   @default(pending)
  score            Decimal?      @db.Decimal(8, 2)
  videoUrl         String?       @map("video_url")
  /// When the student last sent the video link (core C6b).
  videoSubmittedAt DateTime?     @map("video_submitted_at") @db.Timestamptz
  /// The promotion that created this entry; null for Round 1 entries (core C6a).
  promotionRunId   String?       @map("promotion_run_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user             User          @relation(fields: [userId], references: [id])
  round            Round         @relation(fields: [roundId], references: [id])
  scores           JuryScore[]
  promotionRun     PromotionRun? @relation(fields: [promotionRunId], references: [id], onDelete: Restrict)

  @@unique([userId, roundId])
  @@index([roundId, status])
  @@index([promotionRunId])
  @@map("round_entries")
}

/// One promotion from a round to the next, per category (core C6a). Written once, in the same transaction as the
/// entries it creates; never changed. A category is promoted once per round (UNIQUE).
model PromotionRun {
  id               String       @id @default(uuid(7)) @db.Uuid
  fromRoundId      String       @map("from_round_id") @db.Uuid
  toRoundId        String       @map("to_round_id") @db.Uuid
  category         Category
  topN             Int          @map("top_n")
  /// `exam`: a quiz round's published snapshot (source_exam_id, source_generation); `jury`: a video round's averages.
  sourceKind       String       @map("source_kind")
  sourceExamId     String?      @map("source_exam_id") @db.Uuid
  sourceGeneration Int?         @map("source_generation")
  promotedCount    Int          @map("promoted_count")
  eliminatedCount  Int          @map("eliminated_count")
  createdById      String       @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  fromRound        Round        @relation("PromotionFrom", fields: [fromRoundId], references: [id], onDelete: Restrict)
  toRound          Round        @relation("PromotionTo", fields: [toRoundId], references: [id], onDelete: Restrict)
  sourceExam       Exam?        @relation(fields: [sourceExamId], references: [id], onDelete: Restrict)
  createdBy        User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  entries          RoundEntry[]

  @@unique([fromRoundId, category])
  @@index([toRoundId])
  @@index([sourceExamId])
  @@index([createdById])
  @@map("promotion_runs")
}

/// A judge's share of a video round (core C6b): the judge sees and scores the sent videos of these categories only,
/// without the students' names. "All categories" is one row per category.
model JuryAssignment {
  id          String   @id @default(uuid(7)) @db.Uuid
  roundId     String   @map("round_id") @db.Uuid
  judgeId     String   @map("judge_id") @db.Uuid
  category    Category
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  round       Round    @relation(fields: [roundId], references: [id], onDelete: Restrict)
  judge       User     @relation("JuryAssignmentJudge", fields: [judgeId], references: [id], onDelete: Restrict)
  createdBy   User     @relation("JuryAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([roundId, judgeId, category])
  @@index([judgeId])
  @@index([createdById])
  @@map("jury_assignments")
}

/// Append-only jury scoring history (core C6b): who scored, the criteria scores, the total out of 100 the server
/// computed. A judge scores again with a new row; the entry's score is the average of each judge's latest total.
model JuryScore {
  id        String     @id @default(uuid(7)) @db.Uuid
  entryId   String     @map("entry_id") @db.Uuid
  judgeId   String     @map("judge_id") @db.Uuid
  criteria  Json // { criterionKey: 0..10 } validated server-side
  total     Decimal    @db.Decimal(8, 2)
  comment   String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  entry     RoundEntry @relation(fields: [entryId], references: [id])
  judge     User       @relation(fields: [judgeId], references: [id])

  @@index([entryId, createdAt])
  @@index([judgeId])
  @@map("jury_scores")
}

/// A certificate (core C6c): issued by the worker from database state, one per (user, type, round); revoked, never
/// deleted. The name is copied at issue time, so a later profile edit does not change a certificate.
model Certificate {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  type              String // participation | promotion | winner (CHECK in raw SQL)
  roundId           String    @map("round_id") @db.Uuid
  serial            String    @unique
  /// Random, for the public check; the only way to look a certificate up without a session.
  verificationCode  String    @unique @map("verification_code")
  nameOnCertificate String    @map("name_on_certificate")
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  revokedById       String?   @map("revoked_by_id") @db.Uuid
  revokeReason      String?   @map("revoke_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user              User      @relation(fields: [userId], references: [id])
  round             Round     @relation(fields: [roundId], references: [id], onDelete: Restrict)
  revokedBy         User?     @relation("CertificateRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@unique([userId, type, roundId])
  @@index([userId])
  @@index([roundId, type])
  @@index([revokedById])
  @@map("certificates")
}

// ───────────── Ambassadors, points, teams, tasks ─────────────

model AmbassadorProfile {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  promoCode  String    @unique @map("promo_code") @db.Citext // case-insensitive like users.email
  approvedAt DateTime? @map("approved_at") @db.Timestamptz // admin approval (to be confirmed with owner)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id])

  @@map("ambassador_profiles")
}

/// Append-only. Totals/ranks are derived. Corrections = new compensating rows. eventKey makes awards idempotent.
model PointLedger {
  id          String     @id @default(uuid(7)) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  eventKey    String     @unique @map("event_key") // e.g. "referral_paid:<paymentId>", "task:<assignmentId>"
  amount      Int // may be negative for corrections
  reason      String
  taskId      String?    @map("task_id") @db.Uuid
  createdById String?    @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  user        User       @relation("PointOwner", fields: [userId], references: [id])
  createdBy   User?      @relation("PointCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  task        AdminTask? @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([taskId])
  @@index([createdById])
  @@map("point_ledger")
}

model RankThreshold {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique // Bronze, Silver, Gold ...
  minPoints Int      @unique @map("min_points")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("rank_thresholds")
}

/// One team per ambassador; students join with its code (core C5b-3, CORE-PLAN D7).
model Team {
  id        String       @id @default(uuid(7)) @db.Uuid
  /// Free text from a minor, shown to other minors: unique in any letter case; an admin can rename it.
  name      String       @unique @db.Citext
  /// Server-made `TM-` + 6 Crockford characters; matched in any letter case.
  joinCode  String       @unique @map("join_code") @db.Citext
  ownerId   String       @unique @map("owner_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  owner     User         @relation(fields: [ownerId], references: [id])
  members   TeamMember[]

  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@unique([userId]) // one team per student (D7)
  @@map("team_members")
}

model AdminTask {
  id           String           @id @default(uuid(7)) @db.Uuid
  title        String
  description  String
  points       Int
  createdById  String           @map("created_by_id") @db.Uuid
  /// Tasks are never deleted: an archived task takes no new assignments or submissions (core C5b-2).
  archivedAt   DateTime?        @map("archived_at") @db.Timestamptz
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    User             @relation(fields: [createdById], references: [id])
  assignments  TaskAssignment[]
  pointEntries PointLedger[]
  /// Demo data's root marker (DECISIONS "Demo data"): written only by the demo loader, never changed.
  demoBatchId  String?          @map("demo_batch_id") @db.Uuid
  demoBatch    DemoBatch?       @relation(fields: [demoBatchId], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([demoBatchId])
  @@map("admin_tasks")
}

model TaskAssignment {
  id           String     @id @default(uuid(7)) @db.Uuid
  taskId       String     @map("task_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  status       TaskStatus @default(assigned)
  /// The ambassador's proof, plain text (a minor's free text: never logged or audited; core C5b-2).
  proofText    String?    @map("proof_text")
  submittedAt  DateTime?  @map("submitted_at") @db.Timestamptz
  /// The admin's note when rejecting; the ambassador sees it and may submit again.
  reviewNote   String?    @map("review_note")
  approvedById String?    @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?  @map("approved_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  task         AdminTask  @relation(fields: [taskId], references: [id])
  user         User       @relation("TaskAssignee", fields: [userId], references: [id])
  approvedBy   User?      @relation("TaskApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([approvedById])
  @@index([status, submittedAt]) // the admins' review queue (core C5b-2)
  @@map("task_assignments")
}

/// Admin-written notices for students (core C4). Plain text; for everyone (category NULL) or one category; shown
/// from published_at on; archived instead of deleted. Raw SQL (*_core_announcements_checks) adds length CHECKs and a
/// partial index for the students' list.
model Announcement {
  id          String     @id @default(uuid(7)) @db.Uuid
  title       String
  body        String
  category    Category? // NULL = everyone
  publishedAt DateTime   @default(now()) @map("published_at") @db.Timestamptz
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz
  createdById String     @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   User       @relation(fields: [createdById], references: [id])
  /// Demo data only: written by the demo loader, never changed, never set by the API.
  demoBatchId String?    @map("demo_batch_id") @db.Uuid
  demoBatch   DemoBatch? @relation(fields: [demoBatchId], references: [id], onDelete: Restrict)

  @@index([publishedAt])
  @@index([createdById])
  @@index([demoBatchId])
  @@map("announcements")
}

// ───────────── Demo data (DECISIONS 2026-11-08) ─────────────

/// One load of demo data; at most one exists. demo_clear(id) removes it and everything it made.
model DemoBatch {
  id            String         @id @default(uuid(7)) @db.Uuid
  /// loading | loaded | failed | clearing (CHECK)
  status        String
  reason        String
  /// The admin who clicked; NULL for the CLI (an operator at the server).
  createdById   String?        @map("created_by_id") @db.Uuid
  /// Rows per area once loaded, e.g. { "students": 300 }.
  counts        Json           @default("{}")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy     User?          @relation("DemoBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  records       DemoRecord[]
  users         User[]         @relation("DemoUsers")
  exams         Exam[]
  announcements Announcement[]
  tasks         AdminTask[]
  rounds        Round[]

  @@index([createdById])
  @@map("demo_batches")
}

/// Every row a demo load inserted: the Postgres table name and the row id as text.
model DemoRecord {
  tableName String    @map("table_name")
  rowId     String    @map("row_id")
  batchId   String    @map("batch_id") @db.Uuid
  batch     DemoBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@id([tableName, rowId])
  @@index([batchId])
  @@map("demo_records")
}

// ───────────── Free book (plan section 16) ─────────────

/// confirmed -> shipped (admin). Nothing is tracked after shipping (plan B6).
enum BookOrderStatus {
  confirmed
  shipped
}

/// A book cover: the system's first upload (RULEBOOK §15, plan 16.5). Kept in Postgres, so every API replica sees it
/// and the nightly pg_dump backs it up; served only by the API with fixed headers. Old covers stay (the audit trail
/// points to them). Raw SQL adds CHECKs: the content type (jpeg, png, webp), the size (1 B to 800 KB), the sides
/// (100 to 4000 px).
model BookImage {
  id          String   @id @default(uuid(7)) @db.Uuid
  sha256      String   @unique
  contentType String   @map("content_type")
  byteSize    Int      @map("byte_size")
  width       Int
  height      Int
  data        Bytes
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  uploader User @relation("BookImageUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([uploadedBy]) // every foreign key has an index (schema invariant)
  @@map("book_images")
}

/// One free book per paid student (plan 16, owner 2026-10-31). The composite foreign key (registration_id, user_id)
/// means an order exists only for the student's own registration, and a registration exists only for a paid payment.
/// Raw SQL adds: the lengths, the phone format, the district in the 64, shipped <=> shipped_at and shipped_by, and a
/// trigger that locks the address once shipped (the status never goes back).
model BookOrder {
  id             String          @id @default(uuid(7)) @db.Uuid
  userId         String          @unique @map("user_id") @db.Uuid
  registrationId String          @unique @map("registration_id") @db.Uuid
  status         BookOrderStatus @default(confirmed)
  recipientName  String          @map("recipient_name")
  recipientPhone String          @map("recipient_phone") // 01XXXXXXXXX; may differ from the student's, not unique
  district       String
  upazila        String
  addressLine    String          @map("address_line")
  note           String?
  bookTitle      String          @map("book_title") // the title when confirmed: a later rename never changes it
  version        Int             @default(1) // +1 per change; the student sends it back (another tab)
  confirmedAt    DateTime        @default(now()) @map("confirmed_at") @db.Timestamptz
  shippedAt      DateTime?       @map("shipped_at") @db.Timestamptz
  shippedBy      String?         @map("shipped_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user         User         @relation("BookOrderOwner", fields: [userId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId, userId], references: [id, userId], onDelete: Restrict)
  shipper      User?        @relation("BookOrderShipper", fields: [shippedBy], references: [id], onDelete: Restrict)

  @@unique([registrationId, userId]) // Prisma needs it for the one-to-one composite relation (each column is unique too)
  @@index([status, createdAt])
  @@index([district])
  @@index([recipientPhone])
  @@index([shippedBy]) // every foreign key has an index (schema invariant)
  @@map("book_orders")
}

/// Admin two-factor login (TOTP, RFC 6238). The secret is sealed with AES-256-GCM (TOTP_ENCRYPTION_KEY,
/// `v1:<keyId>:…`), never stored in clear. enabledAt NULL: enrolment started, not confirmed yet. lastStep: the newest
/// time step accepted, so a code works once.
model UserTwoFactor {
  userId           String    @id @map("user_id") @db.Uuid
  secretCiphertext String    @map("secret_ciphertext")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz
  lastStep         BigInt?   @map("last_step")
  /// Codes tried on a PENDING factor (reserved before the check): the 5th wrong one deletes the row. 0 once enabled.
  enableAttempts   Int       @default(0) @map("enable_attempts")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor")
}

/// One-time recovery codes for two-factor login: SHA-256 of the normalised code (50 bits of entropy each), used once.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

/// E7b: a correction of a published question's key, after attempts were taken. The question row stays as it was (it is
/// frozen once published); the newest correction's to_key is the key everywhere a key is read (scoring, the review).
/// Append-only (a revert is another correction); the rescore job brings the scores in line.
model AnswerKeyCorrection {
  id          String   @id @default(uuid(7)) @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  /// The question version the attempts saw.
  questionId  String   @map("question_id") @db.Uuid
  fromKey     String   @map("from_key")
  toKey       String   @map("to_key")
  reason      String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Restrict)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([questionId, createdAt(sort: Desc)])
  @@index([examId, createdAt(sort: Desc)])
  @@index([createdById]) // the foreign key's index (db-constraints' catalog check)
  @@map("answer_key_corrections")
}
