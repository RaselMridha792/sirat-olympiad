{
  "name": "@sirat/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint src prisma test",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "jest",
    "test:int": "node --env-file-if-exists=.env test/prepare-test-db.mjs && jest --config test/jest-int.config.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "admin:create": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "paystation:selfcheck": "tsx --env-file-if-exists=.env src/cli/paystation-selfcheck.ts",
    "ops:alert": "tsx --env-file-if-exists=.env src/cli/ops-alert.ts",
    "ops:check": "tsx --env-file-if-exists=.env src/cli/ops-check.ts",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:fixtures:dev": "tsx --env-file-if-exists=.env prisma/fixtures/dev-fixtures.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1160.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^6.19.0",
    "@sirat/shared": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.0.0",
    "nestjs-pino": "^4.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.5",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/prisma"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
