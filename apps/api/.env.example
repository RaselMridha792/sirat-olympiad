# ---- HOST-SIDE DEV ENV: copy to apps/api/.env. NEVER COMMIT .env ----
# Used by `pnpm dev:api`, the Prisma CLI, seed/fixtures and integration tests on your machine.
# Talks to the dev compose override (infra/docker-compose.dev.yml) on 127.0.0.1 with offset ports.
# Use the same POSTGRES_PASSWORD as the root .env.
NODE_ENV=development
DATABASE_URL=postgresql://sirat:change-me-fake@127.0.0.1:16432/sirat?pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://sirat:change-me-fake@127.0.0.1:15432/sirat
# Integration tests only. The database name MUST end with _test (scripts refuse anything else).
TEST_DATABASE_URL=postgresql://sirat:change-me-fake@127.0.0.1:15432/sirat_test
REDIS_CACHE_URL=redis://127.0.0.1:16379
REDIS_QUEUE_URL=redis://127.0.0.1:16380
# Required. Generate: openssl rand -base64 48 (the API refuses short, repetitive or placeholder values).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# Plain-http local development (some browsers drop Secure cookies on http://localhost). Never false on a server.
COOKIE_SECURE=false
# DEV-ONLY fixtures. Left blank on purpose: set the confirmation per run, never permanently, and never on a server:
#   ALLOW_DEV_FIXTURES=yes-this-is-not-production pnpm --filter @sirat/api db:fixtures:dev
#   (PowerShell: $env:ALLOW_DEV_FIXTURES='yes-this-is-not-production'; pnpm --filter @sirat/api db:fixtures:dev)
# The dev Postgres must run with infra/docker-compose.dev.yml (it carries the sirat.environment marker).
ALLOW_DEV_FIXTURES=
# Your own local password for the fixture students (at least 12 characters).
FIXTURE_PASSWORD=
