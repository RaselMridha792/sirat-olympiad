# ---- HOST-SIDE DEV ENV: copy to apps/api/.env. NEVER COMMIT .env ----
# Used by `pnpm dev:api`, the Prisma CLI, seed/fixtures and integration tests on your machine.
# Talks to the dev compose override (infra/docker-compose.dev.yml) on 127.0.0.1 with offset ports.
# Use the same POSTGRES_PASSWORD as the root .env.
NODE_ENV=development
DATABASE_URL=postgresql://sirat:change-me-fake@127.0.0.1:16432/sirat?pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://sirat:change-me-fake@127.0.0.1:15432/sirat
# Integration tests only. The database name MUST end with _test (scripts refuse anything else).
TEST_DATABASE_URL=postgresql://sirat:change-me-fake@127.0.0.1:15432/sirat_test
# Optional: the app under test connects as the runtime role sirat_app (test/load-env.ts), with the root .env's
# POSTGRES_APP_PASSWORD. Unset: the tests run the app as the owner and skip the sirat_app checks (RUNBOOK section 0).
# Same host and database as TEST_DATABASE_URL (the tests refuse anything else).
# TEST_APP_DATABASE_URL=postgresql://sirat_app:<POSTGRES_APP_PASSWORD>@127.0.0.1:15432/<your *_test database>
REDIS_CACHE_URL=redis://127.0.0.1:16379
REDIS_QUEUE_URL=redis://127.0.0.1:16380
# Email (worker and integration tests): Mailpit from the dev override; UI at http://127.0.0.1:18025
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Sirat Olympiad <no-reply@sirat.test>
MAILPIT_URL=http://127.0.0.1:18025
# Operator inbox for alerts (security, payments, ops); blank = audit log and log only. Mailpit catches it locally.
SECURITY_ALERT_EMAIL=
# Required. Generate: openssl rand -base64 48 (the API refuses short, repetitive or placeholder values).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# A refresh rotation must commit within this many ms (100-10000), or it is rolled back and answers 503 while the
# old cookies keep working. Keep the default; DECISIONS "Refresh rotation inside a time budget".
REFRESH_ROTATION_BUDGET_MS=8000
# Requests per minute and route for one signed-in user, whatever IP they share (10-10000). Keep the default.
API_LIMIT_PER_USER_PER_MINUTE=120
# Plain-http local development (some browsers drop Secure cookies on http://localhost). Never false on a server.
COOKIE_SECURE=false
# Admin two-factor login. Unset = 2FA off on this machine (nothing enforced, the 2FA routes answer 503; development
# only). To try it:  printf 'TOTP_ENCRYPTION_KEY=%s\n' "$(openssl rand -base64 32)" >> apps/api/.env
# Enrolments made under one key do not work under another. The integration tests ignore this value: only the 2FA
# suites set their own key (test/load-env.ts).
# TOTP_ENCRYPTION_KEY=
# DEV-ONLY fixtures. Left blank on purpose: set the confirmation per run, never permanently, and never on a server:
#   ALLOW_DEV_FIXTURES=yes-this-is-not-production pnpm --filter @sirat/api db:fixtures:dev
#   (PowerShell: $env:ALLOW_DEV_FIXTURES='yes-this-is-not-production'; pnpm --filter @sirat/api db:fixtures:dev)
# The dev Postgres must run with infra/docker-compose.dev.yml (it carries the sirat.environment marker).
ALLOW_DEV_FIXTURES=
# Your own local password for the fixture students (at least 12 characters).
FIXTURE_PASSWORD=
# ---- Registration and payments: PayStation (docs/plans/PAYMENTS-PLAN.md section 3.5) ----
# Blank PAYSTATION_ENV = payments disabled. For sandbox work: PAYSTATION_ENV=sandbox plus your own sandbox account's
# merchant id (exactly as issued, keep any "-") and password, typed in by hand, never committed or printed.
# The host comes from an allow-list in the code: leave PAYSTATION_BASE_URL blank. `live` is refused here.
PAYSTATION_ENV=
PAYSTATION_BASE_URL=
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
PAYSTATION_ACCOUNT_LABEL=
PAYSTATION_INVOICE_PREFIX=T
# A browser redirect, so http://localhost is fine here (the API's own port; the invoice is appended).
PAYSTATION_CALLBACK_URL=http://localhost:4000/api/payments/paystation/callback
# Blank locally; a temporary https tunnel URL only while testing the IPN (plan section 8.1).
PAYSTATION_IPN_URL=
PAYSTATION_PAY_WITH_CHARGE=0
