// Type-check only (pnpm typecheck): app code plus seed, fixtures and integration tests.
// The build still uses tsconfig.json (src only).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "incremental": false
  },
  "include": ["src", "prisma", "test"]
}
