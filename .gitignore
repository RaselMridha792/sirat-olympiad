node_modules
.next
dist
coverage
*.log
.env
.env.*
!.env.example
.DS_Store
*.tsbuildinfo
.turbo
backups/
# PayStation Postman exports from the merchant dashboard carry merchantId/password (docs/paystation/README.md).
# Commit only a redacted copy named *.redacted.json.
docs/paystation/*.json
!docs/paystation/*.redacted.json
# The official PayStation docs PDF shows shared sandbox credentials; it stays local (summary: PAYSTATION-NOTES.md).
docs/paystation/*.pdf
# TLS material and DB dumps never go into git.
infra/nginx/certs/*
!infra/nginx/certs/.gitkeep
*.pem
*.key
*.dump
# Old Zero Olympiad copies are a local, read-only spec (reference/README.md); new files under reference/ are never committed.
# Files committed here before this rule (README.md, zero-olympiad-ui/, zero-olympiad-server/) stay tracked until the owner decides.
/reference/
# Written by `next dev` (Next 16 agent rules); not project documentation.
apps/web/AGENTS.md
# Throwaway copy used to type-check each commit in isolation (git archive + offline install).
/.verify/
