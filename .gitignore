# PayStation Postman exports from the merchant dashboard carry merchantId/password (docs/paystation/README.md).
# Commit only a redacted copy named *.redacted.json.
docs/paystation/*.json
!docs/paystation/*.redacted.json
# The official PayStation docs PDF shows shared sandbox credentials; it stays local (summary: PAYSTATION-NOTES.md).
docs/paystation/*.pdf
# TLS material and DB dumps never go into git.
infra/nginx/certs/*
!infra/nginx/certs/.gitkeep
*.pem
*.key
*.dump
