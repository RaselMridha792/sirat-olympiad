# scripts/deploy.sh settings (L9). Copy to .env.deploy in the clone (git-ignored), then `chmod 600 .env.deploy`.
# KEY=VALUE lines only; no value is ever printed. A blank value takes the default named in its comment. RUNBOOK §2.

# Required: the compose project, always explicit (`sirat` on the VPS), so a deploy can never act on another stack.
DEPLOY_PROJECT=
# Compose files, space-separated, from the clone root. Default: infra/docker-compose.yml
DEPLOY_COMPOSE_FILES=
# The release file (release.env), the releases log and the deploy lock, outside the clone. Default: /var/lib/sirat
DEPLOY_RELEASE_DIR=
# The public check's base URL. Default: APP_URL from .env
DEPLOY_PUBLIC_URL=
# Run before migrate when a release adds migrations. Default: sudo -n systemctl start sirat-backup.service
DEPLOY_BACKUP_CMD=
# The CI gate: the commit must be on origin/main with a passed CI run. The repository (default: this project's) and a
# fine-grained read-only token (Actions: read), required outside rehearsal mode.
DEPLOY_GITHUB_REPO=
DEPLOY_GITHUB_TOKEN=
# Free space Docker needs before a build, in GB. Default: 10
DEPLOY_MIN_FREE_GB=
# Releases whose images stay for a rollback (at least 2). Default: 3
DEPLOY_KEEP_RELEASES=
# Seconds the app containers get to become healthy. Default: 240
DEPLOY_WAIT_SECONDS=
# Rehearsal only, refused for project sirat: 1 accepts commits of DEPLOY_REHEARSAL_BRANCH (default: rehearsal) and
# skips the CI gate. Default: 0
DEPLOY_REHEARSAL=
DEPLOY_REHEARSAL_BRANCH=
