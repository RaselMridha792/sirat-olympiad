# scripts/deploy.sh settings (L9). Copy to .env.deploy in the clone (git-ignored), then `chmod 600 .env.deploy`.
# KEY=VALUE lines only; no secret is ever printed. RUNBOOK section 2.

# The compose project: always explicit, so a deploy can never act on another clone's stack.
DEPLOY_PROJECT=sirat
# Compose files, space-separated, from the clone root.
DEPLOY_COMPOSE_FILES=infra/docker-compose.yml
# The release file (release.env), the releases log and the deploy lock live here, outside the clone.
DEPLOY_RELEASE_DIR=/var/lib/sirat
# The public check's base URL; blank: APP_URL from .env.
DEPLOY_PUBLIC_URL=
# Started before migrate when a release adds migrations (the root-owned unit, one sudo rule from bootstrap.sh).
DEPLOY_BACKUP_CMD=sudo -n systemctl start sirat-backup.service
# The CI gate: the commit must be on origin/main with a passed CI run. A fine-grained read-only token (Actions: read).
DEPLOY_GITHUB_REPO=RaselMridha792/sirat-olympiad
DEPLOY_GITHUB_TOKEN=
# Free space Docker needs before a build, in GB.
DEPLOY_MIN_FREE_GB=10
# Releases whose images stay for a rollback (at least 2).
DEPLOY_KEEP_RELEASES=3
# How long the app containers get to become healthy, in seconds.
DEPLOY_WAIT_SECONDS=240
# Rehearsal only (refused for project sirat): accept commits of this branch and skip the CI gate.
DEPLOY_REHEARSAL=0
DEPLOY_REHEARSAL_BRANCH=rehearsal
