# Mounted by docker-compose at /etc/nginx/proxy_params_inline.
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
# nginx-generated id (overwrites any client value): the API logs it and returns it as X-Request-ID.
proxy_set_header X-Request-ID $request_id;
proxy_connect_timeout 5s;
proxy_read_timeout 30s;
# Retry another replica only when the connection itself failed (never replay a request that timed out,
# it may already have been processed), and at most once.
proxy_next_upstream error;
proxy_next_upstream_tries 2;
