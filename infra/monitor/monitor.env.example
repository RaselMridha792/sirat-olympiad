# .env.monitor in the clone on the VPS (git-ignored), mode 0600: monitor.sh refuses anything else. Names only here; the
# heartbeat URL never goes into git or the app's .env. KEY=VALUE lines only: the file is read, never run as shell.

# Compose project of the stack (always explicit; the compose file pins `name: sirat`).
MONITOR_PROJECT=
# Heartbeat (outside uptime service): pinged when no check is critical, /fail with the check names otherwise.
MONITOR_HEARTBEAT_URL=
# Optional (defaults in brackets): compose files [infra/docker-compose.yml] and env files [.env], both relative to the
# clone (the VPS adds the release file: `.env /var/lib/sirat/release.env`); the state kept between runs
# [/var/lib/sirat/monitor-state.json]; deploy.sh's lock [/var/lib/sirat/deploy.lock]; backup.sh's status file
# [/var/lib/sirat/last-backup]; the origin certificate [infra/nginx/certs/origin.pem]; the file systems to watch
# [/ /var/lib/docker].
MONITOR_COMPOSE_FILES=
MONITOR_COMPOSE_ENV_FILES=
MONITOR_STATE_FILE=
MONITOR_DEPLOY_LOCK=
MONITOR_BACKUP_STATUS=
MONITOR_CERT_FILE=
MONITOR_DISK_PATHS=
