# /etc/sirat/backup.env on the VPS: root-owned, mode 0600 (backup.sh refuses anything else). Names only here; the
# values (the put-only key's config path, the heartbeat URL) never go into git or the app's .env.
# KEY=VALUE lines only: the file is read, never run as shell.

# Compose project of the stack to dump (always explicit; the compose file pins `name: sirat`).
BACKUP_PROJECT=
# Compose files, relative to the clone (default infra/docker-compose.yml), and the env file compose reads (default .env).
BACKUP_COMPOSE_FILES=
BACKUP_COMPOSE_ENV_FILE=
# Where the encrypted copies are kept on the server (default /var/backups/sirat, made 0700) and how many (default 3).
BACKUP_DIR=
BACKUP_KEEP_LOCAL=
# rclone destination, e.g. sirat-backups:bucket/vps (an S3 remote with a put-only key, owner Q1), or `none` for a
# local-only run that warns and pings nothing. RCLONE_CONFIG names the root-only rclone config holding that key.
BACKUP_REMOTE=
RCLONE_CONFIG=
# The age public keys (default infra/backup/recipients.txt in the clone).
BACKUP_RECIPIENTS=
# Heartbeat (outside uptime service): pinged after each verified upload, /fail on any error. Blank: no pings.
BACKUP_HEARTBEAT_URL=
# The world-readable file with the created_at and sha256 of the newest off-server copy, for monitor.sh's backup age check
# (default /var/lib/sirat/last-backup).
BACKUP_STATUS_FILE=
# Optional tuning: lock file and wait (default /var/lib/sirat/backup.lock, 900 s), pg_dump --lock-wait-timeout
# (default 60s), the smallest dump accepted as a percentage of the last (default 50), and the age --verify accepts
# for the newest copy (default 26 hours).
BACKUP_LOCK=
BACKUP_LOCK_WAIT_SECONDS=
BACKUP_PG_LOCK_WAIT=
BACKUP_MIN_SIZE_PERCENT=
BACKUP_MAX_AGE_HOURS=
